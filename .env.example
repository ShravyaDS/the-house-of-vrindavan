# Copy this file to ".env" and fill in your own values before first run.
# These only control the DEFAULT admin account created on first run
# and the session secret used to sign login cookies.

ADMIN_USERNAME=admin
ADMIN_PASSWORD=vrindavan@123
SESSION_SECRET=vrindavan@123vrindavan@123
DATABASE_URL=postgresql://user:password@ep-xxxxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# Optional: change the port the server runs on
# PORT=3000

# Optional: override local storage locations. Render sets these automatically
# in render.yaml so the database and uploaded images use the persistent disk.
# DATA_DIR=./data
# UPLOAD_DIR=./public/uploads/products
